# Ascent environment. Copy to .env.local for dev; set the same keys in your
# host (Vercel) for production. Everything is optional — the app runs keyless
# with deterministic research, template drafts, and local demo state. Adding a
# key unlocks the matching live behavior.

# --- Authentication -------------------------------------------------------
# Signs the login session cookie. REQUIRED in production; a dev fallback is
# used when unset. Generate one: `openssl rand -base64 32`
AUTH_SECRET=

# Google sign-in ("Continue with Google") AND the Search Console analytics
# connection (one OAuth client does both). In the Google Cloud console add
# BOTH Authorized redirect URIs:
#   https://YOUR_DOMAIN/api/auth/google/callback
#   https://YOUR_DOMAIN/api/connect/gsc/callback
# and enable the "Google Search Console API" on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in AND one-click repo publishing (one OAuth App does both).
# Register the callback URL: https://YOUR_DOMAIN/api/connect/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (Stripe) -------------------------------------------------------
# Real subscription checkout. Without these, checkout runs in demo mode.
# STRIPE_SECRET_KEY: Developers -> API keys (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add endpoint
# https://YOUR_DOMAIN/api/billing/webhook with events checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring Price ID to use instead of the built-in $49/month
STRIPE_PRICE_ID=

# --- Autonomous engine ----------------------------------------------------
# Postgres (Neon / Supabase / RDS). Activates multi-tenant storage and the
# real per-site autonomous cycle. Apply db/schema.sql after setting it.
DATABASE_URL=

# Live competitor research + LLM-written pages via Gemini with Google Search
# grounding. Without it, research and drafts fall back to deterministic logic.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# Protects the daily cron endpoint (/api/cron/run). The Vercel cron sends it
# as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
